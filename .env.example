# ==============================================================================
# BOOKING SALON - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Ghi chú: Hệ thống đã cấu hình sẵn 100% (Zero-Config) trong docker-compose.yml.
# Bao gồm cả Keycloak SSO, MySQL và Redis.
# Bạn chỉ cần chạy lệnh sau là hệ thống tự khởi động đầy đủ:
#   docker compose up -d --build
#
# Tạo file .env từ template này NẾU BẠN MUỐN thay đổi mật khẩu hoặc kết nối dịch vụ thật:
#   cp .env.example .env
# ==============================================================================

# ── 1. CƠ SỞ DỮ LIỆU (DATABASE - TÙY CHỌN ĐỔI) ────────────────────────────────
DB_PASSWORD=rootpassword123
HOST_DB_PORT=3307

# ── 2. DỊCH VỤ CLOUD BÊN NGOÀI (CHỈ ĐIỀN KHI DÙNG THẬT) ──────────────────────
# Lưu trữ hình ảnh Cloudinary (để trống sẽ dùng mock mặc định)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Đăng nhập mạng xã hội Google SSO qua Keycloak (để trống nếu không dùng)
KEYCLOAK_IDP_GOOGLE_CLIENT_ID=
KEYCLOAK_IDP_GOOGLE_CLIENT_SECRET=

# Gửi Email thông báo SMTP (Gmail App Password)
MAIL_USERNAME=
MAIL_PASSWORD=
