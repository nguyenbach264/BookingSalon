# Auto detect text files and perform LF normalization
* text=auto

# Java files
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Frontend files
*.jsx text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.svg text eol=lf
