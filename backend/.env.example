# ==============================================================================
# BOOKING SALON - BACKEND LOCAL DEV ENVIRONMENT TEMPLATE
# ==============================================================================
# Dành cho chạy backend trực tiếp qua Maven/IDE (không qua Docker Compose).
# Tạo file backend/.env từ template này:
#   cp backend/.env.example backend/.env
# ==============================================================================

# ── 1. CƠ SỞ DỮ LIỆU & CACHE (DATABASE & REDIS) ──────────────────────────────
DB_HOST=localhost
DB_PORT=3307
DB_NAME=bookingsalon_app
DB_USERNAME=bookingsalon_user
DB_PASSWORD=rootpassword123
JPA_DDL_AUTO=validate

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── 2. KEYCLOAK SSO / IAM ────────────────────────────────────────────────────
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_REALM=booking-salon-realm
KEYCLOAK_CLIENT_ID=booking-salon-admin
KEYCLOAK_CLIENT_SECRET=dev-local-secret-booking-salon-2026
KEYCLOAK_FRONTEND_CLIENT_ID=booking-salon-client

# ── 3. DỊCH VỤ TÙY CHỌN (OPTIONAL) ───────────────────────────────────────────
# Cloudinary (Ảnh)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=demo_key
CLOUDINARY_API_SECRET=demo_secret

# Google SSO (Đăng nhập mạng xã hội)
KEYCLOAK_IDP_GOOGLE_ENABLED=false
KEYCLOAK_IDP_GOOGLE_CLIENT_ID=
KEYCLOAK_IDP_GOOGLE_CLIENT_SECRET=

# SMTP Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
