# ==========================================
# BookingSalon Backend Environment Variables
# ==========================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookingsalon
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JPA_DDL_AUTO=update

# Keycloak Configuration
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_REALM=booking-salon-realm
KEYCLOAK_CLIENT_ID=booking-salon-admin
KEYCLOAK_CLIENT_SECRET=your_keycloak_admin_client_secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# VNPay Payment Gateway
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/webhooks/vnpay/callback
VNPAY_NOTIFY_URL=http://localhost:8080/api/v1/payments/webhook/vnpay

# Sepay Gateway
SEPAY_MERCHANT_ID=your_sepay_merchant_id
SEPAY_SECRET_KEY=your_sepay_secret_key
SEPAY_API_BASE_URL=https://pgapi.sepay.vn
SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key
SEPAY_ENV=sandbox

# Bank Transfer
PAYMENT_BANK_BIN=123456
PAYMENT_BANK_ACCOUNT=0866429205
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret
PAYMENT_EXPIRE_MINUTES=15

# SMTP Mail Server
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

