# =======================================================
# BookingSalon Backend Environment Variables Template
# =======================================================
# LƯU Ý BẢO MẬT:
# 1. KHÔNG commit file .env chứa giá trị thật lên Git!
# 2. Sao chép file này thành .env: `cp .env.example .env`
# 3. Điền các thông tin bí mật tương ứng với môi trường chạy.
# =======================================================

# ── 1. DATABASE CONFIGURATION ───────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookingsalondb
# Production: TUYỆT ĐỐI KHÔNG dùng tài khoản root! Dùng user riêng phân quyền tối thiểu (least privilege).
DB_USERNAME=bookingsalon_app
DB_PASSWORD=your_strong_db_password_here
JPA_DDL_AUTO=validate

# ── 2. KEYCLOAK SSO / AUTH SERVER ───────────────────────
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_REALM=booking-salon-realm
KEYCLOAK_CLIENT_ID=booking-salon-admin
KEYCLOAK_CLIENT_SECRET=your_keycloak_admin_client_secret_here
KEYCLOAK_FRONTEND_CLIENT_ID=booking-salon-client

# Google Identity Provider (Keycloak Social Login)
KEYCLOAK_IDP_GOOGLE_ENABLED=true
KEYCLOAK_IDP_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
KEYCLOAK_IDP_GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ── 3. REDIS DISTRIBUTED CACHE & LOCK ────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── 4. VNPAY PAYMENT GATEWAY (SANDBOX / PRODUCTION) ─────
# Khi chạy dev/test nội bộ, bật simulator mode: true
VNPAY_SIMULATOR_MODE=true
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/webhook/vnpay/return
VNPAY_NOTIFY_URL=http://localhost:8080/api/v1/payments/webhook/vnpay

# ── 5. SEPAY GATEWAY (VIETQR AUTOMATION) ─────────────────
SEPAY_MERCHANT_ID=your_sepay_merchant_id_here
SEPAY_SECRET_KEY=your_sepay_secret_key_here
SEPAY_API_BASE_URL=https://pgapi.sepay.vn
SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key_here
SEPAY_ENV=sandbox

# ── 6. BANK TRANSFER DIRECT ──────────────────────────────
PAYMENT_BANK_BIN=970422
PAYMENT_BANK_ACCOUNT=your_bank_account_number
PAYMENT_WEBHOOK_SECRET=your_bank_webhook_secret_here
PAYMENT_EXPIRE_MINUTES=15

# ── 7. SMTP EMAIL (GMAIL APP PASSWORD / AWS SES) ─────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_system_email@domain.com
MAIL_PASSWORD=your_16_char_gmail_app_password

# ── 8. CLOUDINARY MEDIA STORAGE ──────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── 9. CORS & FRONTEND URL ───────────────────────────────
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
